# =============================================================================
# Hébergement OVH (Apache) : sécurité, HTTPS et cache
# Mêmes règles que docker/security-headers.conf et docker/nginx.conf
# =============================================================================

# Pas de liste des fichiers d'un dossier
Options -Indexes

# ---------- Adresse unique : www.thomas-jondeau.fr → thomas-jondeau.fr ----------
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.thomas-jondeau\.fr$ [NC]
RewriteRule ^(.*)$ https://thomas-jondeau.fr/$1 [R=301,L]

# ---------- Toujours en HTTPS ----------
# (chez OVH, le test sur le port est plus fiable que %{HTTPS})
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

<IfModule mod_headers.c>
  # ---------- En-têtes de sécurité ----------
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
  # le navigateur retient qu'il faut toujours passer en HTTPS (1 an)
  Header always set Strict-Transport-Security "max-age=31536000"

  # ---------- Cache ----------
  # page, styles et scripts : revalidés à chaque visite (les mises à jour sont visibles tout de suite)
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # bibliothèque 3D, icônes, image d'aperçu et musique : une semaine
  <FilesMatch "(three\.min\.js|\.svg|\.ico|\.png|\.jpg|\.mp3)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ---------- Fichiers cachés : jamais servis ----------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
